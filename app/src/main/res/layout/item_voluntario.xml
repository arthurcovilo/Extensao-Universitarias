<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Nome e badge de área -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/txtNomeVoluntario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nome do Voluntário"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtBadgeArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beleza"
                android:textSize="11sp"
                android:textColor="@color/primary_red"
                android:background="@drawable/bg_badge_red"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtEmailVoluntario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="email@exemplo.com"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtAreasVoluntario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Áreas: —"
            android:textColor="@color/text_description"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtDiasVoluntario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dias: —"
            android:textColor="@color/text_description"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txtEventosVoluntario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 eventos participados"
            android:textColor="@color/primary_red"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
