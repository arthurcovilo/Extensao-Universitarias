<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_card_evento"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:padding="14dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/txtHistoricoTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Título do Evento"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/txtHistoricoStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABERTO"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="#6750A4"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtHistoricoData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="01/01/2025"
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/txtHistoricoLocal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Local"
        android:textSize="13sp"
        android:textColor="#888888" />

</LinearLayout>
