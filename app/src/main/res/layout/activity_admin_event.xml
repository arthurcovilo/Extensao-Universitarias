<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header com botão voltar -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnVoltarAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#8617;"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/txtTituloAdmin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Criar Evento"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editTitulo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ex: Distribuição de Alimentos"
                android:inputType="textCapSentences"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Descrição -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descrição"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descreva o evento..."
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:gravity="top"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Tipo de Evento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de Evento *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerTipo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp" />

            <!-- Data -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnSelecionarData"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Selecionar data"
                android:background="@drawable/bg_botao_secundario"
                android:textColor="@color/text_description"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Local -->
            <TextView
                android:id="@+id/txtLocalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editLocal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Ex: Centro Comunitário - São Paulo"
                android:inputType="textCapSentences"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Limite de participantes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limite de participantes (0 = sem limite)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editLimite"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="0"
                android:inputType="number"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Status (visível apenas na edição) -->
            <TextView
                android:id="@+id/txtStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/spinnerStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <!-- Botão Salvar -->
            <Button
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Salvar Evento"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_botao_inscrever"
                android:layout_marginBottom="12dp" />

            <!-- Botão Excluir (apenas na edição) -->
            <Button
                android:id="@+id/btnExcluir"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Excluir Evento"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/status_red_dark"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Botão Ver Inscritos (apenas na edição) -->
            <Button
                android:id="@+id/btnVerInscritos"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Ver Inscritos"
                android:textAllCaps="false"
                android:textColor="@color/primary_red"
                android:background="@drawable/bg_botao_secundario"
                android:visibility="gone"
                android:layout_marginBottom="24dp" />

            <ProgressBar
                android:id="@+id/progressAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
