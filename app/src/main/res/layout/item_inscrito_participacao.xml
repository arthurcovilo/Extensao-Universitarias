<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_card_evento"
    android:layout_marginBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/txtNomeInscrito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Voluntário"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEmailInscrito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@exemplo.com"
                android:textColor="#666666"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtStatusAtual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inscrito"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#6750A4"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </LinearLayout>

    <!-- Botões de status -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnParticipou"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Participou"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />

        <Button
            android:id="@+id/btnNaoCompareceu"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Não foi"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E65100" />

        <Button
            android:id="@+id/btnCancelado"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Cancelou"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B71C1C" />

    </LinearLayout>

</LinearLayout>
