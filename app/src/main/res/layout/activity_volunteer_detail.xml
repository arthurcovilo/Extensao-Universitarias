<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#F7F7F7"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Cabeçalho com botão voltar -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/btnVoltar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#8617;"
                    android:textSize="24sp"
                    android:textColor="#222222"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/txtNomeDetalhe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Voluntário"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

            </LinearLayout>

            <!-- Card de dados pessoais -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card_evento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E-mail"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/txtEmailDetalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="email@exemplo.com"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eventos participados"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/txtEventosDetalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 eventos"
                    android:textSize="16sp"
                    android:textColor="#6750A4"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Card de áreas -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card_evento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Áreas de atuação"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtAreasDetalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Não informado"
                    android:textSize="15sp"
                    android:textColor="#444444" />

            </LinearLayout>

            <!-- Card de disponibilidade -->
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card_evento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dias disponíveis"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#222222"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/txtDiasDetalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Não informado"
                    android:textSize="15sp"
                    android:textColor="#444444" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
