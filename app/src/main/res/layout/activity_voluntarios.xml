<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#F7F7F7"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Cabeçalho com botão voltar -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#8617;"
            android:textSize="24sp"
            android:textColor="#222222"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Voluntários"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/txtContadorVoluntarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 voluntários"
            android:textSize="14sp"
            android:textColor="#666666" />

    </LinearLayout>

    <!-- Campo de busca por nome -->
    <EditText
        android:id="@+id/editBuscaVoluntario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar por nome..."
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:background="@drawable/bg_card_evento"
        android:padding="12dp"
        android:textSize="16sp"
        android:inputType="text"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp" />

    <!-- Seção de filtros -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_evento"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:padding="12dp">

        <!-- Título + botão limpar -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Filtrar por área"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#444444" />

            <TextView
                android:id="@+id/btnLimparFiltros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limpar filtros"
                android:textSize="12sp"
                android:textColor="#6750A4"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Chips de área -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupAreas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="false"
            android:layout_marginBottom="10dp" />

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filtrar por dia"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#444444"
            android:layout_marginBottom="8dp" />

        <!-- Chips de dia -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupDias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="false" />

    </LinearLayout>

    <!-- Barra de filtros ativos -->
    <HorizontalScrollView
        android:id="@+id/scrollFiltrosAtivos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutFiltrosAtivos"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filtrando: "
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAtivos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Mensagem de lista vazia -->
    <TextView
        android:id="@+id/txtVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhum voluntário encontrado."
        android:textSize="16sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_marginTop="40dp"
        android:visibility="gone" />

    <!-- Lista de voluntários -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerVoluntarios"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:clipToPadding="false" />

</LinearLayout>
