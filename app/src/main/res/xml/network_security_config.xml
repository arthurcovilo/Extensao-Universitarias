<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuração de segurança de rede.

    Em DEBUG: permite HTTP para o emulador Android (10.0.2.2) e localhost.
    Em RELEASE: apenas HTTPS é permitido (padrão seguro do Android).

    Quando o backend estiver em produção com HTTPS:
    1. Remova o bloco <domain-config> abaixo.
    2. Remova usesCleartextTraffic do AndroidManifest.xml.
    3. Atualize AppConfig.BASE_URL para a URL HTTPS de produção.
-->
<network-security-config>

    <!-- Permite HTTP apenas para o emulador em desenvolvimento -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Todos os outros domínios exigem HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
