# 1. Copie este arquivo para keystore.properties (raiz do projeto)
# 2. Preencha com os dados reais do seu keystore
# 3. NUNCA commite keystore.properties no Git (já está no .gitignore)
# ─────────────────────────────────────────────────────────────

storeFile=../meu-keystore.jks
storePassword=SENHA_DO_KEYSTORE
keyAlias=ALIAS_DA_CHAVE
